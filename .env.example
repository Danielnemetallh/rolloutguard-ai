# Database: Neon Postgres preferred; SQLite works offline for local demo
# Neon: postgresql+psycopg2://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./rolloutguard.db

# Demo identity
DEMO_USER_NAME=Demo-Analystin
DEMO_USER_ROLE=Analystin

# LLM — DeepSeek (OpenAI-compatible). Set DEEPSEEK_API_KEY and LLM_ENABLED=true
# for live agent answers. Without a key, or with LLM_ENABLED=false, the API uses
# a deterministic demo mock.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# low | high | max | disabled
DEEPSEEK_REASONING_EFFORT=low
LLM_ENABLED=false

# Composio — Gmail / Calendar / Notion after Freigeben.
# Use a Project key (ak_...) from Platform settings, or a Connect key (ck_...) from For You.
# Leave empty for file fallback (CI).
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=demo-analystin
# Optional: Notion database for Freigeben board cards
COMPOSIO_NOTION_DATABASE_ID=

# Paths (relative to backend/ when using scripts/dev-api.ps1)
UPLOAD_DIR=../data/uploads
SYNTHETIC_DIR=../data/synthetic

# App
APP_ENV=development
# Dev API port (scripts/dev-api.ps1). Frontend Vite proxy must match.
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
