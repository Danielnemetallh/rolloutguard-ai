# Database: Neon Postgres preferred; SQLite works offline for local demo
# Neon: postgresql+psycopg2://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./rolloutguard.db

# Demo identity
DEMO_USER_NAME=Demo Analyst
DEMO_USER_ROLE=analyst

# LLM — OpenCode Zen (OpenAI-compatible). Leave empty to use deterministic mock.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4-flash-free
OPENCODE_REASONING_EFFORT=medium
LLM_ENABLED=false

# Paths (relative to backend/ when using scripts/dev-api.ps1)
UPLOAD_DIR=../data/uploads
SYNTHETIC_DIR=../data/synthetic

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
