# Database: Neon Postgres preferred; SQLite works offline for local demo
# Neon: postgresql+psycopg2://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./rolloutguard.db

# Demo identity
DEMO_USER_NAME=Demo-Analystin
DEMO_USER_ROLE=Analystin

# LLM — DeepSeek (OpenAI-compatible). Leave empty to use deterministic mock.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# low | high | max | disabled
DEEPSEEK_REASONING_EFFORT=low
LLM_ENABLED=false

# Composio — Gmail / Calendar / Notion after Freigeben. Leave empty for file fallback (CI).
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=demo-analystin
# Optional: Notion database for Freigeben board cards
COMPOSIO_NOTION_DATABASE_ID=

# Paths (relative to backend/ when using scripts/dev-api.ps1)
UPLOAD_DIR=../data/uploads
SYNTHETIC_DIR=../data/synthetic

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
