# Neon Postgres connection string (pooled recommended for serverless)
# Example: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DB?sslmode=require

# Demo identity
DEMO_USER_NAME=Demo Analyst
DEMO_USER_ROLE=analyst

# LLM — OpenCode Zen (OpenAI-compatible). Leave empty to use deterministic mock.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=big-pickle
LLM_ENABLED=false

# Paths
UPLOAD_DIR=../data/uploads
SYNTHETIC_DIR=../data/synthetic

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
